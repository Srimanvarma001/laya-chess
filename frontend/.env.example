# Copy this file to .env.local and adjust as needed.

# Base URL the browser uses to reach Laya (Phase 1).
# /api goes through the Vite dev proxy (vite.config.ts) to http://localhost:8000.
# Do not point this straight at :8000: laya-serve sends no CORS headers, so the
# browser blocks the request.
# Later this can point to a tunnel URL, then to a hosted API, with no code changes.
VITE_API_BASE_URL=/api

# Only set this if you started Laya with LAYA_API_KEY set.
# NOTE: this is fine for a Phase-1 local-only prototype (the key never leaves
# your machine because the frontend also runs on localhost). Do NOT deploy a
# build with a real key baked into it — see docs/experiments/security-notes.md.
VITE_LAYA_API_KEY=
